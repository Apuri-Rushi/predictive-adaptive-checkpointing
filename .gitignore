# =====================================================================
# Predictive Disk Failure-Aware Adaptive Checkpointing: .gitignore
# Excluded files are NOT deleted. They stay on the author's machine and
# are regenerated by the scripts described in README.md.
# =====================================================================

# ---- Everything at the top level except the research project ---------
# (raw Backblaze archive, third-party traces, manuscript drafts and PDFs)
/*
!/project/
!/README.md
!/requirements.txt
!/.gitignore
!/.gitattributes

# ---- Raw and processed datasets (~4.6 GB) -----------------------------
/project/dataset/
/project/ml/processed/*.csv.gz

# ---- Third-party papers (copyrighted PDFs) ----------------------------
/project/papers/

# ---- Vendored CloudSim 3.0.3 (download from the official release) -----
/project/cloudsim/vendor/*
!/project/cloudsim/vendor/downloads/
/project/cloudsim/vendor/downloads/*
!/project/cloudsim/vendor/downloads/SHA256SUMS.txt

# ---- Build outputs -----------------------------------------------------
/project/cloudsim/build/
/project/cloudsim/research/build/
*.class

# ---- Bulk simulation outputs (~11 GB) ---------------------------------
# Kept: manifest.csv, run_config.json, shard logs, validation/ and analysis/
/project/cloudsim/results/full_rho*/shard_*/
/project/cloudsim/results/full_rho*/*.tmp/
# Pilots: keep PILOT_REPORT.md and validation/, drop the raw run folders
/project/cloudsim/results/pilot*/*/
!/project/cloudsim/results/pilot*/validation/

# ---- Duplicate archives of folders already in the repo ----------------
/project/paper_assets.zip
/project/paper_assets/overleaf_assets.zip

# ---- Python / tooling --------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# ---- LaTeX build by-products -----------------------------------------
*.aux
*.log.tex
*.synctex.gz
*.fdb_latexmk
*.fls
*.out
*.bbl
*.blg

# ---- OS / editor -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ---- Secrets (none exist; guard against future additions) -------------
.env
.env.*
*.pem
*.key
*.p12
credentials*.json
